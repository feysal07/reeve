{
  "uid": "reeve-overview",
  "title": "Reeve",
  "tags": ["reeve"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "type": "text",
      "title": "What this shows, and what it does not",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "Usage and cost as the collector computed it from tokens and your price table. There is no identity here: no emails, no sessions, no repository names. Those live in the event store, which has different access control and different retention, and `reeve report` reads them.\n\n**Computed cost and vendor-reported cost are separate series on purpose. Do not add them together.** They are two measurements of the same thing, kept apart so that a discrepancy is visible rather than averaged away.\n\nRequests whose model was not in your price table are counted separately as unpriced. Treating them as costing nothing would understate the total while the dashboard looked complete."
      }
    },
    {
      "type": "stat",
      "title": "Cost computed from tokens (7d)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 } },
      "targets": [
        {
          "expr": "sum(increase(reeve_cost_usd_total[7d]))",
          "legendFormat": "computed",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Cost as the vendors reported it (7d)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 } },
      "targets": [
        {
          "expr": "sum(increase(reeve_vendor_reported_cost_usd_total[7d]))",
          "legendFormat": "vendor",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Requests with no price for their model",
      "description": "These carry tokens and cost something, and none of it is in the figures to the left.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(reeve_events_unpriced_total[7d]))",
          "legendFormat": "unpriced",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Batches the collector could not read",
      "description": "An agent is exporting something this collector does not understand, so that agent's activity is missing from everything else on this page.",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(reeve_batches_rejected_total[7d]))",
          "legendFormat": "rejected",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cost by agent",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [
        {
          "expr": "sum by (agent) (increase(reeve_cost_usd_total[1h]))",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens by agent and kind",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (agent, kind) (increase(reeve_tokens_total[1h]))",
          "legendFormat": "{{agent}} {{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Events written by agent",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (agent) (increase(reeve_events_written_total[1h]))",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Is anything still arriving?",
      "description": "Seconds since the event store was last written. A line that climbs forever means the agents stopped exporting, and every other panel here will quietly flatten rather than saying so.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "time() - reeve_store_modified_timestamp_seconds",
          "legendFormat": "since last write",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      }
    ]
  }
}
